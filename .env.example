# ---------------------------------------------------------------------------
# Spotify Web API (required for real data)
# Create an app at https://developer.spotify.com/dashboard — no redirect URI is
# needed, this uses the client-credentials flow.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Market used for catalogue availability and track relinking.
SPOTIFY_MARKET=US

# ---------------------------------------------------------------------------
# Play counts (optional)
#
# The documented Web API does NOT expose stream counts — only a 0-100
# popularity score. Real per-track play counts come from the private GraphQL
# API behind open.spotify.com. Leave everything below unset to try the
# anonymous route; set one of the values if that stops working.
# ---------------------------------------------------------------------------

# Master switch. Set to 0 to run on popularity alone.
SPOTIFY_PARTNER_ENABLED=1

# Highest priority: a bearer token copied from a pathfinder request in your
# browser's devtools. Expires in about an hour.
SPOTIFY_PARTNER_TOKEN=

# The sp_dc cookie from a logged-in open.spotify.com session. Longer lived
# than a bearer token. Treat it like a password — it authenticates your account.
SPOTIFY_SP_DC=

# If Spotify requires TOTP-signed token requests, supply the base32 secret.
SPOTIFY_TOTP_SECRET=
SPOTIFY_TOTP_VERSION=5

# Persisted-query hashes are discovered from the web player automatically.
# Override one if discovery fails:
# SPOTIFY_PQ_QUERYARTISTOVERVIEW=<sha256>
# SPOTIFY_PQ_GETALBUM=<sha256>

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Serve generated sample data instead of calling Spotify. No credentials needed.
MOCK=0

# Caching. A full catalogue costs dozens of upstream calls, so keep this on.
CACHE_DIR=.cache
CACHE_ARTIST_TTL=21600
CACHE_SEARCH_TTL=1800
CACHE_MAX_ENTRIES=500

# Politeness / safety limits.
SPOTIFY_CONCURRENCY=6
SPOTIFY_MAX_RELEASES=400
SPOTIFY_TIMEOUT_MS=20000
RATE_LIMIT_PER_MINUTE=120
